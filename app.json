{
  "expo": {
    "name": "BlackBook",
    "slug": "blackbook-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "blackbook",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.modnight.blackbook",
      "supportsTablet": true
    },
    "android": {
      "package": "com.modnight.blackbook",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 286,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
