{
  "name": "blackbook-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "validate": "node ./scripts/validate-foundation.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run typecheck",
    "generate:splash": "node ./scripts/build-splash-vector.mjs",
    "prebuild:android": "npm run generate:splash && expo prebuild --platform android --clean",
    "build:apk": "npm run prebuild:android && cd android && ./gradlew assembleRelease --no-daemon -PreactNativeArchitectures=arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "1.34.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
